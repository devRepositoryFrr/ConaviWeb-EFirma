@model ConaviWeb.Model.Request.ChangePasswordRequest
@{
    Layout = "_Layout";
    ViewBag.Title = "Actualizar contraseña";
}

<div class="col-sm-6 col-sm-offset-3">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h2 class="form-signin-heading">Actualizar contraseña</h2>
        </div>
        <div class="panel-body">
            @Html.Raw(@ViewBag.Alert)

            <form method="post" asp-action="ChangePassword">
                @Html.AntiForgeryToken()
                <div class="alert alert-danger" asp-validation-summary="ModelOnly">
                    <button class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                </div>

                <div class="form-group">
                    <label asp-for="SUser"></label>
                    <input class="form-control" asp-for="SUser" />
                    <span asp-validation-for="SUser" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Modulo"></label>
                    <select class="form-control" id="modulo" name="Modulo">
                        <option value="0">--- Seleccione ---</option>
                        <option value="1"> Contratos </option>
                        <option value="2"> Convenios </option>
                        <option value="4"> RH </option>
                        <option value="5"> Actas CF </option>
                        <option value="6"> Actas CS </option>
                    </select>
                    <span asp-validation-for="Modulo" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CurrentPassword"></label>
                    <input class="form-control" asp-for="CurrentPassword" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewPassword"></label>
                    <input class="form-control" asp-for="NewPassword" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmNewPassword"></label>
                    <input class="form-control" asp-for="ConfirmNewPassword" />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                </div>

                <button class="btn btn-primary pull-right" type="submit">
                    <span class="fa fa-save"></span>&ensp;Actualizar
                </button>
                <a class="btn btn-danger" href="@Url.Action("Index", "Login")">Volver</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}