            </div>
        </div>
    </div>

    @section Scripts {@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}}
    <script>
        $(document).ready(function () {
            showAlert();

            // Limpiar estado de formulario de firma al llegar al login
            sessionStorage.removeItem('formSignSubmitted');
            sessionStorage.removeItem('formSignTime');

            // Mostrar mensaje si la sesión expiró
            var urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('expired') === 'true') {
                showExpiredMessage();
                // Limpiar el parámetro de la URL sin recargar
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        });

        function showExpiredMessage() {
            var alertHtml = '<div id="alertaExpired" class="alert alert-warning alert-dismissible fade in" role="alert">' +
                '<button type="button" class="close" data-dismiss="alert" aria-label="Close">' +
                '<span aria-hidden="true">&times;</span></button>' +
                '<strong>Sesión expirada.</strong> Por favor, inicie sesión nuevamente.</div>';
            $('.panel-body').prepend(alertHtml);

            setTimeout(function () {
                $("#alertaExpired").fadeOut(2000);
            }, 5000);
        }

        $(window).on('beforeunload', function () {
            console.log("before");

            $('.spinner').css('display', 'block');
        });

        function showAlert() {

            setTimeout(function () {
                $("#alerta").fadeOut(1500);

            }, 3000);
            setTimeout(function () {

                $("#alerta").remove();
            }, 6000);

        }
    </script>
